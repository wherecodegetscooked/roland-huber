# Beispiel fuer Umgebungsvariablen. Kopie als .env anlegen.
# Vite-Variablen muessen mit VITE_ beginnen, um im Client verfuegbar zu sein.
# VITE_API_URL=https://api.example.com

# Kontaktformular (Cloudflare Worker + Resend):
# Der API-Key gehoert NICHT in Git, sondern als Worker-Secret hinterlegt:
#   npx wrangler secret put RESEND_API_KEY
# Fuer lokales Testen mit "wrangler dev" kann er in einer .dev.vars stehen
# (ebenfalls gitignored):
#   RESEND_API_KEY=re_xxxxxxxx
